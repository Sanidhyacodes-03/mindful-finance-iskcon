# Copy this file to ".env" and fill in your real values.
# .env is already in .gitignore, so your secrets won't be committed.

# --- Flask ---
SECRET_KEY=change-this-to-something-random

# --- Database (Postgres/Supabase) ---
# Leave DATABASE_URL blank to use the built-in SQLite database (spendly.db) — this is
# the default and needs no setup. Set it to switch to Postgres/Supabase instead.
# Use the "Direct connection" string from Supabase (Project Settings > Database >
# Connection string > URI tab), port 5432 — NOT the transaction-mode pooler on port
# 6543, since this app manages its own connection pool.
# Shape: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:iskonshirpur@db.ngxempvpuephyvidnklc.supabase.co:5432/postgres
CLERK_PUBLISHABLE_KEY=pk_test_YnJhdmUtZmF3bi0xMDYuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_1a4zVwmJ8y69BdM8FLaq64rr5AkHs0xdJwwbuZxXcZ
CLERK_ORG_ID=org_3Jfcz8rUSNwckQ3LHQAVE4p8pxP
# Only needed if supabase-py (Storage/Auth/Realtime) is added later — not required
# for the DATABASE_URL/psycopg2 connection above.
SUPABASE_URL=
SUPABASE_KEY=

# Optional connection-pool sizing (defaults shown)
PG_POOL_MINCONN=1
PG_POOL_MAXCONN=10

# --- Email (Gmail SMTP example) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SENDER_EMAIL=youremail@gmail.com

# --- WhatsApp (Twilio sandbox) ---
WHATSAPP_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
