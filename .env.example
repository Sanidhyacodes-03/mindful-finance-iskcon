# Copy this file to ".env" and fill in your real values.
# .env is already in .gitignore, so your secrets won't be committed.

# --- Flask ---
SECRET_KEY=change-this-to-something-random

# --- Database (Postgres/Supabase) ---
# Leave DATABASE_URL blank to use the built-in SQLite database (spendly.db) — this is
# the default and needs no setup. Set it to switch to Postgres/Supabase instead.
# Use the "Direct connection" string from Supabase (Project Settings > Database >
# Connection string > URI tab), port 5432 — NOT the transaction-mode pooler on port
# 6543, since this app manages its own connection pool.
# Shape: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Only needed if supabase-py (Storage/Auth/Realtime) is added later — not required
# for the DATABASE_URL/psycopg2 connection above.
SUPABASE_URL=
SUPABASE_KEY=

# Optional connection-pool sizing (defaults shown)
PG_POOL_MINCONN=1
PG_POOL_MAXCONN=10

# --- Clerk (B2B Organizations auth) ---
# Leave all four blank to keep today's local email/password login — this is the
# default and needs no setup. Set all four to switch to Clerk (passwordless
# Email/Phone OTP + Google OAuth, invite-only ISKCON Shirpur org membership).
# From your Clerk dashboard > API Keys:
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional — derived automatically from CLERK_PUBLISHABLE_KEY if left blank.
# "Frontend API URL" on that same dashboard page, e.g. clean-example-1.clerk.accounts.dev
CLERK_FRONTEND_API=
# From Clerk dashboard > Organizations > (your ISKCON Shirpur org) — starts with "org_"
CLERK_ORG_ID=
# Optional, recommended — makes sign-in checks fully offline (no Clerk calls per page).
# Clerk dashboard > API Keys > "Show JWT public key" > PEM. Paste it on one line with
# each line break written as \n, e.g. -----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
CLERK_JWT_KEY=

# --- Google Drive backup (uploaded bills/vouchers, every 15 days) ---
# Leave GOOGLE_DRIVE_BACKUP_FOLDER_ID blank to keep backups off — this is the
# default and needs no setup. Setup steps are at the bottom of services/backup_service.py.
# Path to the service account's downloaded JSON key (never commit this file — already
# in .gitignore). Defaults to "credentials.json" in the project root if unset.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# The Drive folder's ID (from its URL: drive.google.com/drive/folders/<THIS>) — must be
# shared with the service account's email (Editor access) or uploads will fail.
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# --- Email (Gmail SMTP example) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SENDER_EMAIL=youremail@gmail.com

# --- WhatsApp (Twilio sandbox) ---
WHATSAPP_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# --- Donations webhook (external project) ---
# Every donation logged on the Donations page is POSTed here as JSON.
# Leave blank to skip sending (donations are still saved locally).
DONATIONS_WEBHOOK_URL=
# The app waits at most 3 seconds for their API, then saves the donation as "not sent".
# Recipient of the donations CSV + PDF report (manual button + every 7 days).
DONATIONS_REPORT_EMAIL=shirpuriskcon@gmail.com

# --- Background jobs ---
# Set to true to run the scheduler: weekly donations report email, daily Supabase
# keep-alive ping, weekly DB health email, month-end alerts, Drive backups.
START_SCHEDULER=true
# Who gets the URGENT "Database Offline" and weekly health-check emails.
ADMIN_ALERT_EMAIL=shirpuriskconacc@gmail.com
